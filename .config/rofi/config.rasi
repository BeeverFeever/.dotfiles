* {
   background-color: #1F1F28;
   text-color:       #DCD7BA;
   font: "ComicCodeLigatures Bold 10";
}


window {
   padding: 1em;
   border-color: #DCA561;
   border: 1px;
   border-radius: 5px;
   background-color: #1F1F28;
}

mainbox {
   spacing: 0px;
   children: [message,inputbar,listview];
}

message {
   enabled: true;
   margin: 0px 100px;
   padding: 15px;
   border: 0px solid;
   border-radius: 15px;
   border-color: inherit;
   background-color: inherit;
   text-color: inherit;
   size: 400em;
}
textbox {
   background-color: inherit;
   text-color: inherit;
   vertical-align: 0.5;
   horizontal-align: 0.5;
   placeholder-color: inherit;
   blink: true;
   markup: true;
   size: 400em;
}
error-message {
   padding: 12px;
   border: 0px solid;
   border-radius: 0px;
   border-color: inherit;
   background-color: inherit;
   text-color: inherit;
}

element {
   background: transparent;
   children: [ element-icon, element-text ];
}
element,element-text,element-icon, button {
   cursor: pointer;
}

inputbar {
   margin: 0px 10px;
   spacing: 0.4em;
   border-color: #1F1F28;
   border: 5px;
   background-color: #2A2A37;
   children: [entry,overlay,case-indicator];
}


listview, message {
   padding: 0.5em;
   border-color: #282738;
   border: 5px;
   border-radius: 10px;
   background-color: #1F1F28;
   columns: 1;
   lines: 8;
}
listview {
   border: 0px 5px 5px 5px;
   spacing: 10px;
   background-color: #1F1F28;
   border-color: #1F1F28;
   scrollbar: true;
}


element {
   border: 5px;
   border-radius: 5px;
   padding: 5px;
   border-color: #363646;
}
element-text {
   background-color: #363646;
   text-color: #C8C093;
}

element normal.normal {
   background-color: #363646;
   text-color: #C8C093;
}
element normal.urgent {
   background-color: #363646;
   text-color: #C8C093;
}
element normal.active {
   background-color: #363646;
   text-color: #C8C093;
}

element selected.normal {
   background-color: #6A9589;
   border-color: #6A9589;
   text-color: #C8C093;
}
element selected.urgent {
   background-color: #6A9589;
   border-color: #6A9589;
   text-color: #C8C093;
}
element.selected.active {
   background-color: #6A9589;
   border-color: #6A9589;
   text-color: #C8C093;
}

element.alternate.normal {
   background-color: #363646;
   text-color: #E5B9C6;
}
element.alternate.urgent {
   background-color: #282738;
   text-color: #E5B9C6;
}
element.alternate.active {
   background-color: 282738;
   text-color: #E5B9C6;
}


element-text.selected.normal {
   background-color: #6A9589;
   border-color: #E5B9C6;
   text-color: #DCD7BA;
}
element-text.selected.urgent {
   background-color: #E5B9C6;
   border-color: #E5B9C6;
   text-color: #282738;
}
element-text.selected.active {
   background-color: #E5B9C6;
   border-color: #E5B9C6;
   text-color: #282738;
}

scrollbar {
   width: 4px ;
   border: 0;
   handle-color: #E5B9C6;
   handle-width: 8px ;
   padding: 0;
}
mode-switcher {
   border: 0px;
   spacing: 0px;
   expand: true;
}
button {
   text-color: #E5B9C6;
   border: 0px 0px 5px ;
   border-color: #1F1F28;
   border-radius: 10px 10px 0 0;
   background-color: #282738;
   horizontal-align: 0.5;
}
button selected.normal {
   text-color: #E5B9C6;
   margin: 0px;
   padding: 0px;
   border: 5px 5px 5px 5px ;
   border-color: #282738;
   border-radius: 10px 10px 10px 10px;
   background-color: #353446;
}

entry {
   placeholder: "Search";
   placeholder-color: #16161D;
   border: 10px;
   border-color: #353446;
   border-radius: 2px 2px 2px 2px;
   background-color: #353446;
   text-color: #DCD7BA;
}
